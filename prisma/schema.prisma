generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                            String            @id @default(uuid())
  email                         String            @unique
  passwordHash                  String
  phone                         String?
  role                          Role              @default(CUSTOMER)
  isEmailVerified               Boolean           @default(false)
  isPhoneVerified               Boolean           @default(false)
  isRegistrationFeePaid         Boolean           @default(false)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  accountStatus                 AccountStatus     @default(ACTIVE)
  emailVerificationAttempts     Int               @default(0)
  emailVerificationLastSentAt   DateTime?
  emailVerificationOtpExpiresAt DateTime?
  emailVerificationOtpHash      String?
  adminLogs                     AuditLog[]
  blockedBy                     BlockedUser[]     @relation("BlockedUsers")
  blockedUsers                  BlockedUser[]     @relation("BlockerUsers")
  bookingsAsCustomer            Booking[]         @relation("CustomerBookings")
  companionProfile              CompanionProfile?
  companionConversations        Conversation[]    @relation("CompanionConversations")
  customerConversations         Conversation[]    @relation("CustomerConversations")
  customerProfile               CustomerProfile?
  favorites                     Favorite[]
  feedbacks                     Feedback[]
  messagesSent                  Message[]
  notifications                 Notification[]
  payments                      Payment[]
  reportsReceived               Report[]          @relation("ReportsReceived")
  reportsFiled                  Report[]          @relation("ReportsFiled")
  reviewsReceived               Review[]          @relation("ReviewsReceived")
  reviewsGiven                  Review[]          @relation("ReviewsGiven")
  availabilityRequestsAsCustomer AvailabilityRequest[] @relation("CustomerAvailabilityRequests")
  passwordResetTokens           PasswordResetToken[]


  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([accountStatus, createdAt])
  @@index([role, createdAt])
}

model CustomerProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  name          String
  displayAvatar String?
  age           Int
  gender        String?
  city          String?
  interests     String[] @default([])
  languages     String[] @default([])
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  gallery       String[] @default([])
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model City {
  id         String             @id @default(uuid())
  name       String             @unique
  state      String
  slug       String             @unique
  imageUrl   String?
  isPopular  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  companions CompanionProfile[]
}

model Activity {
  id                  String              @id @default(uuid())
  name                String              @unique
  slug                String              @unique
  icon                String?
  description         String?
  category            String?
  createdAt           DateTime            @default(now())
  bookings            Booking[]
  companionActivities CompanionActivity[]
}

model CompanionProfile {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  username           String                 @unique
  fullName           String
  displayName        String
  age                Int
  gender             String
  cityId             String
  profilePhoto       String?
  gallery            String[]               @default([])
  bio                String
  languages          String[]               @default([])
  interests          String[]               @default([])
  hourlyPrice        Float                  @default(500)
  verificationStatus VerificationStatus     @default(PENDING)
  verificationReason String?
  isFeatured         Boolean                @default(false)
  averageRating      Float                  @default(0.0)
  totalReviews       Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  availabilitySlots  AvailabilitySlot[]
  bookings           Booking[]              @relation("CompanionBookings")
  activities         CompanionActivity[]
  city               City                   @relation(fields: [cityId], references: [id])
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoritedBy        Favorite[]
  verificationDocs   VerificationDocument[]
  availabilityRequests AvailabilityRequest[] @relation("CompanionAvailabilityRequests")


  @@index([cityId])
  @@index([verificationStatus])
  @@index([hourlyPrice])
  @@index([averageRating])
  @@index([createdAt])
  @@index([verificationStatus, createdAt])
  @@index([verificationStatus, isFeatured, averageRating])
  @@index([verificationStatus, cityId, hourlyPrice])
}

model CompanionActivity {
  companionId String
  activityId  String
  activity    Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  companion   CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@id([companionId, activityId])
}

model VerificationDocument {
  id           String           @id @default(uuid())
  companionId  String
  documentType DocumentType
  fileUrl      String
  status       DocumentStatus   @default(PENDING)
  reviewNotes  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  companion    CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)
  @@index([companionId])
  @@index([status])
  @@index([createdAt])
}

model AvailabilitySlot {
  id          String           @id @default(uuid())
  companionId String
  date        String
  startTime   String
  endTime     String
  isBooked    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  companion   CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, date, startTime])
  @@index([companionId, date])
}

model Booking {
  id                     String           @id @default(uuid())
  bookingNumber          String           @unique
  customerId             String
  companionId            String
  activityId             String
  date                   String
  startTime              String
  endTime                String
  durationHours          Float
  hourlyPriceSnapshot    Float
  totalAmount            Float
  commissionRateSnapshot Float            @default(15.0)
  commissionAmount       Float
  companionEarnings      Float
  status                 BookingStatus    @default(PENDING)
  cancellationReason     String?
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  activity               Activity         @relation(fields: [activityId], references: [id])
  companion              CompanionProfile @relation("CompanionBookings", fields: [companionId], references: [id])
  customer               User             @relation("CustomerBookings", fields: [customerId], references: [id])
  payment                Payment?
  refund                 Refund?
  review                 Review?
  availabilityRequest    AvailabilityRequest?


  @@index([customerId])
  @@index([companionId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerId, status, createdAt])
  @@index([companionId, status, createdAt])
}

model Payment {
  id                String        @id @default(uuid())
  paymentNumber     String        @unique
  userId            String
  bookingId         String?       @unique
  paymentType       PaymentType
  amount            Float
  currency          String        @default("INR")
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?
  errorReason       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
  refunds           Refund[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([paymentType, status, createdAt])
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String
  bookingId        String   @unique
  amount           Float
  reason           String
  status           String   @default("PROCESSED")
  razorpayRefundId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  booking          Booking  @relation(fields: [bookingId], references: [id])
  payment          Payment  @relation(fields: [paymentId], references: [id])
}

model Review {
  id                           String   @id @default(uuid())
  bookingId                    String   @unique
  reviewerId                   String
  revieweeId                   String
  rating                       Int
  comment                      String
  isCustomerReviewingCompanion Boolean  @default(true)
  createdAt                    DateTime @default(now())
  booking                      Booking  @relation(fields: [bookingId], references: [id])
  reviewee                     User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  reviewer                     User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])

  @@index([reviewerId])
  @@index([revieweeId])
}

model Conversation {
  id              String    @id @default(uuid())
  customerId      String
  companionUserId String
  lastMessageAt   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  companionUser   User      @relation("CompanionConversations", fields: [companionUserId], references: [id])
  customer        User      @relation("CustomerConversations", fields: [customerId], references: [id])
  messages        Message[]

  @@unique([customerId, companionUserId])
  @@index([customerId, lastMessageAt])
  @@index([companionUserId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  text           String
  isRead         Boolean      @default(false)
  isReported     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, isRead])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead, createdAt])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         String
  description    String
  status         ReportStatus @default(PENDING)
  messageId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reportedUser   User         @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Favorite {
  id          String           @id @default(uuid())
  customerId  String
  companionId String
  createdAt   DateTime         @default(now())
  companion   CompanionProfile @relation(fields: [companionId], references: [id], onDelete: Cascade)
  customer    User             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, companionId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("BlockerUsers", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([createdAt])
  @@index([adminId, createdAt])
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String
  type      String
  rating    Int?
  message   String
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum Role {
  CUSTOMER
  COMPANION
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  BANNED
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentType {
  REGISTRATION_FEE
  BOOKING_PAYMENT
  REFUND
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DocumentType {
  GOVT_ID
  SELFIE
  ADDRESS_PROOF
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
}

enum AvailabilityRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTER_PROPOSED
  EXPIRED
  CANCELLED
  BOOKED
}

model AvailabilityRequest {
  id                 String                    @id @default(uuid())
  customerId         String
  companionId        String
  requestedDate      String
  requestedStartTime String
  requestedDuration  Float
  experienceType     String
  generalArea        String?
  customerMessage    String?
  counterDate        String?
  counterStartTime   String?
  counterDuration    Float?
  companionMessage   String?
  status             AvailabilityRequestStatus @default(PENDING)
  expiresAt          DateTime
  bookingId          String?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  customer           User                      @relation("CustomerAvailabilityRequests", fields: [customerId], references: [id], onDelete: Cascade)
  companion          CompanionProfile          @relation("CompanionAvailabilityRequests", fields: [companionId], references: [id], onDelete: Cascade)
  booking            Booking?                  @relation(fields: [bookingId], references: [id])

  @@index([customerId])
  @@index([companionId])
  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

